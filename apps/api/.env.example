PLANNER_ENVIRONMENT=development
PLANNER_DATABASE_URL=postgresql+psycopg://planner:planner-local-only@127.0.0.1:5433/planner_dev
PLANNER_DATABASE_SCHEMA=public
PLANNER_WEB_ORIGIN=http://localhost:3000
PLANNER_STORAGE_ROOT=.private
# Server-only. Set both key and chat model to enable AI. Any compatible endpoint may be used.
PLANNER_AI_BASE_URL=https://api.openai.com/v1
PLANNER_AI_API_KEY=
PLANNER_AI_MODEL=
PLANNER_EMBEDDING_MODEL=
PLANNER_AI_DAILY_RUNS=30
PLANNER_AI_DAILY_TOKENS=500000
# Prices are operator-supplied; zero means cost is not priced, not free.
PLANNER_AI_INPUT_USD_PER_MILLION=0
PLANNER_AI_OUTPUT_USD_PER_MILLION=0
# Production: choose private GCS or Supabase storage.
PLANNER_STORAGE_BUCKET=
# Alternative private storage for the Render–Vercel–Supabase deployment.
PLANNER_SUPABASE_URL=
PLANNER_SUPABASE_SERVICE_ROLE_KEY=
PLANNER_SUPABASE_STORAGE_BUCKET=
# Polling uses PostgreSQL jobs without Google Cloud Tasks/OIDC.
PLANNER_WORKER_MODE=cloud_tasks
PLANNER_RUN_WORKER=false
PLANNER_MIGRATE_ON_START=false
PLANNER_WORKER_AUDIENCE=
PLANNER_WORKER_SERVICE_ACCOUNT=
PLANNER_ENCRYPTION_KEY=
PLANNER_SMTP_HOST=
PLANNER_SMTP_PORT=587
PLANNER_SMTP_USER=
PLANNER_SMTP_PASSWORD=
PLANNER_SMTP_FROM=
# HTTPS email delivery for Render Free, which blocks SMTP ports.
# Selection: Brevo when configured, otherwise Resend, otherwise SMTP.
PLANNER_BREVO_API_KEY=
PLANNER_RESEND_API_KEY=
PLANNER_MAX_USER_STORAGE_BYTES=104857600
PLANNER_CLOUD_TASKS_QUEUE=
# Optional OpenTelemetry collector endpoint (traces contain no prompts or content).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
