# Planner environment configuration.
#
# Copy to backend/.env (never commit it). Values below suit local development. On a server,
# tools/deploy/setup.sh writes a production backend/.env itself: generated database credentials,
# session key and absolute paths, plus APP_URL for the chosen ingress (see
# docs/operations/deployment.md). Process environment variables override this file.
# ConfigLoader (src/Config/ConfigLoader.php) validates these values at startup.

# --- Application -----------------------------------------------------------------------------
# Display name only; the application does not read it at present.
APP_NAME="Planner"
# local | testing | production. production requires APP_DEBUG=false and SESSION_SECURE_COOKIE=true.
APP_ENV=local
# Shows detailed errors. Never true on a host reachable by others.
APP_DEBUG=true
# Public origin users open, without a trailing slash. The CSRF check rejects form posts whose
# browser Origin differs from it, and mail links are built from it, so it must match exactly:
#   local: http://localhost:8000 | direct / named tunnel: https://notes.example.com
#   quick tunnel: https://<random>.trycloudflare.com (setup.sh keeps it updated automatically)
APP_URL=http://localhost:8000
# IANA timezone, e.g. UTC or Asia/Ho_Chi_Minh. Stored timestamps stay UTC.
APP_TIMEZONE=UTC

# --- Database (MySQL 8.4, InnoDB) ------------------------------------------------------------
# setup.sh runs MySQL in Docker on 127.0.0.1:3306 with database and user "planner".
PLANNER_DB_HOST=127.0.0.1
PLANNER_DB_PORT=3306
PLANNER_DB_DATABASE=goals_dev
PLANNER_DB_USERNAME=goals_dev
PLANNER_DB_PASSWORD=
# Only utf8mb4 / utf8mb4_0900_ai_ci are accepted.
PLANNER_DB_CHARSET=utf8mb4
PLANNER_DB_COLLATION=utf8mb4_0900_ai_ci
# Comma-separated names PLANNER_DB_DATABASE may take; a guard against pointing at the wrong
# database. Tests require goals_test. Production: only the production name (e.g. planner).
PLANNER_DB_ALLOWED=goals_dev,goals_test

# Legacy DB_* fallbacks remain accepted only to ease local upgrades. New
# installations should configure PLANNER_DB_* above.
DB_USERNAME=goals_dev
DB_PASSWORD=

# --- Sessions --------------------------------------------------------------------------------
# Idle lifetime in minutes.
SESSION_LIFETIME=120
# Secure-only cookies. true whenever users reach the site over HTTPS (required in production);
# false only for plain-HTTP local development.
SESSION_SECURE_COOKIE=false
# Generate an independent base64-encoded 32-byte key; never commit the value.
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Changing it signs everyone out.
SESSION_ENCRYPTION_KEY=

# --- Storage and logging ---------------------------------------------------------------------
# Uploaded files and the local mail outbox; must stay outside backend/public. Relative paths
# resolve from backend/; production should use absolute paths.
PRIVATE_STORAGE_ROOT=storage/app/private
LOG_PATH=storage/logs/planner.log
# debug | info | notice | warning | error | critical | alert | emergency. Use info or higher in production.
LOG_LEVEL=debug

# --- Frontend assets -------------------------------------------------------------------------
# Vite dev server for hot reload during local development (npm run dev), e.g.
# http://127.0.0.1:5173. Leave empty to serve the built assets in backend/public/build, which is
# required whenever anyone other than this machine opens the site (tunnels, servers).
VITE_DEV_URL=

# --- AI assistant ----------------------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey. Keep AI disabled until a
# server-side key is configured. If Google retires the model, the API's 404
# names the replacement; update AI_MODEL to match.
AI_ENABLED=false
# google is the only supported provider.
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash-lite
# Embeddings let "Ask AI" find notes by meaning, not only keywords (falls back to keywords).
AI_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_AI_API_KEY=

# --- Live collaboration (shared notes) ---------------------------------------------------------
# bin/realtime.php is a WebSocket server; run it beside PHP (systemd: planner-realtime).
# Browsers connect to REALTIME_PUBLIC_URL, or when empty to /realtime on APP_URL, which the
# reverse proxy forwards to REALTIME_LISTEN (tools/deploy sets this up for Nginx).
#   local without a proxy: REALTIME_PUBLIC_URL=ws://localhost:8090
# Without the server, shared notes still autosave over HTTP (no live updates).
REALTIME_ENABLED=true
REALTIME_LISTEN=127.0.0.1:8090
REALTIME_PUBLIC_URL=
# Optional dedicated ticket key (32+ chars); otherwise derived from SESSION_ENCRYPTION_KEY.
REALTIME_SECRET=

# --- Email -----------------------------------------------------------------------------------
# Email (verification, password reset, reminders, invitations).
# With MAIL_HOST set, every message is sent through that SMTP server, e.g.
# Gmail: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_ENCRYPTION=tls and an
# app password. Without MAIL_HOST, production uses the system mail transport
# and local/testing keep messages in storage/app/private/mail-outbox.
# Hosts provisioned by setup.sh have no system mail transport: configure SMTP there.
# Check delivery with: php bin/console mail:test you@example.com
# Sender shown to recipients; required whenever mail actually leaves the machine.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Planner
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS, usually port 587) | ssl (usually port 465) | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# Periodic jobs (reminder emails, repeating Tasks, clean-up): run
#   * * * * * cd /path/to/backend && php bin/console schedule:run
# from cron, or keep `php bin/console schedule:work` running.
# setup.sh installs this cron job on servers.
