  "cards": [
    {
      "dot": "cyan",
      "title": "One application",
      "items": [
        "Only backend/public is exposed; browser APIs use same-origin cookie sessions.",
        "Escaped PHP shells and JavaScript page modules share explicit route contracts."
      ]
    },
    {
      "dot": "emerald",
      "title": "Ownership and side effects",
      "items": [
        "Services own transactions; PDO repositories own SQL and user scoping.",
        "Private file I/O is compensated around metadata writes, not exposed as static uploads."
      ]
    },
    {
      "dot": "slate",
      "title": "Committed source scope",
      "items": [
        "Runtime ownership at 2e9e68d: framework-free PHP, explicit wiring, PDO and private storage.",
        "Calendar reuses planning APIs; AI queues Goal/Milestone/Task/Habit/Note proposals and requires explicit Apply. These are feature flows, not separate services.",
        "SMTP, provider adapters and scheduled jobs remain optional infrastructure. The shared floating editor keeps Goal/Milestone/Task edits on the current page."
      ]
    }
  ]
