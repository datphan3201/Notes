  "cards": [
    {
      "dot": "cyan",
      "title": "Independent planning and completion",
      "items": [
        "Add for today records the account-local day and current week atomically; Task dates/status do not change.",
        "Today and Week use the same Task Complete/Reopen operations. A time view is not a stored status.",
        "Full capture can create then select Today/Week; failed selection retains the created Task and reports the partial result."
      ]
    },
    {
      "dot": "amber",
      "title": "History and quiet reminders",
      "items": [
        "Automatic Today and Dashboard overdue reminders respect History thresholds; explicit day/week choices can reveal historical work.",
        "Overdue remains accessible. Reopen replaces an overdue deadline with a non-past date or explicitly removes it.",
        "Completed follows the selected time view; History lists retained work newest first with search and paging."
      ]
    },
    {
      "dot": "slate",
      "title": "Approved contract scope",
      "items": [
        "Describes the approved local planning contract, not a pinned committed-source snapshot.",
