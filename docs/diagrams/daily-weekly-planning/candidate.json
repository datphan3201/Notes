  "cards": [
    {
      "dot": "cyan",
      "title": "Selection is not a status or date edit",
      "items": [
        "Add for today never sets InProgress or rewrites deadline/start/scheduled times. Creating a named Task here also selects day/week in the same transaction.",
        "No automatic day/week carry-forward. Removing a manual day selection keeps the Task/week; automatic membership can still show it."
      ]
    },
    {
      "dot": "amber",
      "title": "Factual labels and quiet overdue reminders",
      "items": [
        "On progress means InProgress. Scheduled means a work start/occurrence/interval today; a deadline today is Due today.",
        "Complete/archive/new deadline removes the overdue condition. Reminders stop at History thresholds; retained old work remains in Tasks \u2192 Overdue."
      ]
    },
