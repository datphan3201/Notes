APP_NAME="Planner"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

PLANNER_DB_HOST=127.0.0.1
PLANNER_DB_PORT=3306
PLANNER_DB_DATABASE=goals_dev
PLANNER_DB_USERNAME=goals_dev
PLANNER_DB_PASSWORD=
PLANNER_DB_CHARSET=utf8mb4
PLANNER_DB_COLLATION=utf8mb4_0900_ai_ci
PLANNER_DB_ALLOWED=goals_dev,goals_test

# Legacy DB_* fallbacks remain accepted only to ease local upgrades. New
# installations should configure PLANNER_DB_* above.
DB_USERNAME=goals_dev
DB_PASSWORD=

SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
# Generate an independent base64-encoded 32-byte key; never commit the value.
SESSION_ENCRYPTION_KEY=

PRIVATE_STORAGE_ROOT=storage/app/private
LOG_PATH=storage/logs/planner.log
LOG_LEVEL=debug
VITE_DEV_URL=

# Create a key at https://aistudio.google.com/apikey. Keep AI disabled until a
# server-side key is configured. If Google retires the model, the API's 404
# names the replacement; update AI_MODEL to match.
AI_ENABLED=false
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash-lite
GOOGLE_AI_API_KEY=

# Email (verification, password reset, reminders, invitations).
# With MAIL_HOST set, every message is sent through that SMTP server, e.g.
# Gmail: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_ENCRYPTION=tls and an
# app password. Without MAIL_HOST, production uses the system mail transport
# and local/testing keep messages in storage/app/private/mail-outbox.
# Check delivery with: php bin/console mail:test you@example.com
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Planner
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# Periodic jobs (reminder emails, repeating Tasks, clean-up): run
#   * * * * * cd /path/to/backend && php bin/console schedule:run
# from cron, or keep `php bin/console schedule:work` running.
