  "cards": [
    {
      "dot": "cyan",
      "title": "Tree meaning",
      "items": [
        "Primary containment only. A Goal chooses Area XOR parent Goal; a Task has zero or one Goal/Milestone parent.",
        "Inbox Tasks have no parent and are outside this tree. Optional Habit placement does not affect Goal progress."
      ]
    },
    {
      "dot": "violet",
      "title": "Relations that are not tree edges",
      "items": [
        "Goal/Milestone/Task/Habit contributions link to additional Goals without moving work or changing progress.",
        "Milestone prerequisites are a separate acyclic graph and block Milestone completion, not Task usage."
      ]
    },
    {
      "dot": "emerald",
      "title": "Progress denominator",
      "items": [
        "Mean immediate child Goal percentages, completed Milestones and direct one-off Tasks.",
        "Exclude Habits, contributions, recurring occurrences and Tasks already represented through Milestones."
      ]
    },
    {
      "dot": "amber",
      "title": "Independent associations and presentation",
      "items": [
        "Notes may link to one owned Goal or Task; note_links does not change primary containment or progress.",
        "Dashboard roadmap and Goals Main goal share one explicit preference; there is no automatic highest-importance fallback.",
        "Areas, Goals, Milestones and Habits support validated icons/accents; all planning levels use importance 1–5. Tasks have no icon."
      ]
    }
  ]
