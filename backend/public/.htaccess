Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Existing public files are served directly; every other request enters
    # the application-owned router through the sole executable entry point.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>
