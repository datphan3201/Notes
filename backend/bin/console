#!/usr/bin/env php
<?php

declare(strict_types=1);

use Planner\Application\Files\ProcessFileDeletion;
use Planner\Application\Files\PruneFiles;
use Planner\Application\Scheduling\Scheduler;
use Planner\Infrastructure\Database\MigrationRunner;
use Planner\Infrastructure\Logging\LoggerFactory;
use Planner\Infrastructure\Persistence\Pdo\Account\PdoAccountRepository;
use Planner\Infrastructure\Persistence\Pdo\Files\AttachmentRepository;
use Planner\Infrastructure\Persistence\Pdo\Files\PendingDeletionRepository;
use Planner\Infrastructure\Persistence\Pdo\Scheduling\PdoScheduledJobRepository;
use Planner\Infrastructure\Storage\LocalPrivateStorage;
use Planner\Application\Planning\PlanningService;
use Planner\Domain\Planning\GoalProgressCalculator;
use Planner\Domain\Planning\GraphGuard;
use Planner\Infrastructure\Persistence\Pdo\Planning\PdoPlanningRepository;
use Planner\Infrastructure\Persistence\Pdo\Recurrence\PdoTaskSeriesRepository;
use Planner\Infrastructure\Persistence\Pdo\Activity\PdoActivityRepository;
use Planner\Http\Security\RateLimiter;
use Planner\Infrastructure\Session\SessionPruner;

/** @var array{migrations: MigrationRunner} $application */
$application = require dirname(__DIR__).'/bootstrap/app.php';
$command = $argv[1] ?? 'help';

// The HTTP runtime is built once, only for jobs that need its services.
$http = null;
$runtime = static function () use (&$http): array {
    return $http ??= require dirname(__DIR__).'/bootstrap/http.php';
};

/**
 * Periodic jobs. Each returns [summary, succeeded] and is also available as
 * its own command. Intervals are in seconds for `schedule:run`/`schedule:work`.
 *
 * @var array<string, array{interval:int, run:Closure(): array{0:string,1:bool}}> $jobs
 */
$jobs = [
    'reminders:send' => ['interval' => 60, 'run' => static function () use ($runtime): array {
        $result = $runtime()['reminder_service']->send();

        return [sprintf('Reminders sent: %d; failed owners: %d', $result['sent'], $result['failed']), $result['failed'] === 0];
    }],
    'recurrence:materialize' => ['interval' => 3600, 'run' => static function () use ($runtime): array {
        $result = $runtime()['task_series_service']->materialize();
        $summary = sprintf('Created occurrences: %d; failed series: %d', $result['created'], count($result['failed']));

        return [$result['failed'] === [] ? $summary : $summary.' ('.implode(', ', $result['failed']).')', $result['failed'] === []];
    }],
    'snapshots:capture' => ['interval' => 21600, 'run' => static function () use ($runtime): array {
        $result = $runtime()['goal_snapshot_service']->capture();

        return [sprintf('Created snapshots: %d; warnings: %d; failed users: %d', $result['created'], count($result['warnings']), count($result['failed'])), $result['warnings'] === [] && $result['failed'] === []];
    }],
    'history:prune' => ['interval' => 3600, 'run' => static function () use ($application): array {
        $result = (new \Planner\Application\Planning\TaskHistoryService(
            new \Planner\Infrastructure\Persistence\Pdo\Planning\PdoTaskHistoryRepository($application['pdo']),
            new \Planner\Infrastructure\Persistence\Pdo\Admin\PdoSystemSettingRepository($application['pdo']),
            $application['transactions'], $application['clock'],
        ))->prune();

        return [sprintf('History checked for %d users; archived %d tasks.', $result['users'], $result['archived']), true];
    }],
    'sessions:prune' => ['interval' => 3600, 'run' => static function () use ($application): array {
        return ['Expired sessions deleted: '.(new SessionPruner($application['pdo']))->pruneExpired(), true];
    }],
    'rate-limits:prune' => ['interval' => 3600, 'run' => static function () use ($application): array {
        return ['Expired rate-limit buckets deleted: '.(new RateLimiter($application['pdo']))->pruneExpired(), true];
    }],
    'files:prune' => ['interval' => 86400, 'run' => static function () use ($application): array {
        $storage = new LocalPrivateStorage(
            $application['config']->string('storage.private_root'),
            $application['config']->string('app.base_path').'/public',
            $application['uuid'],
        );
        $logger = (new LoggerFactory($application['config']))->create();
        $result = (new PruneFiles(
            new ProcessFileDeletion(new PendingDeletionRepository($application['pdo']), $storage, $logger, $application['clock']),
            new AttachmentRepository($application['pdo']),
            new PdoAccountRepository($application['pdo']),
            $storage,
            $application['clock'],
            $logger,
        ))->run();

        return [sprintf(
            'Pending cleaned: %d; pending failed: %d; orphans cleaned: %d; orphans failed: %d',
            $result['pending_completed'],
            $result['pending_failed'],
            $result['orphans_deleted'],
            $result['orphans_failed'],
        ), $result['pending_failed'] === 0 && $result['orphans_failed'] === 0];
    }],
];

$scheduler = static fn (): Scheduler => new Scheduler(
    new PdoScheduledJobRepository($application['pdo']),
    $application['clock'],
    array_map(static fn (array $job): array => [
        'interval' => $job['interval'],
        'run' => static function () use ($job): string {
            [$summary, $succeeded] = ($job['run'])();

            return $succeeded ? $summary : 'failed: '.$summary;
        },
    ], $jobs),
);

try {
    switch ($command) {
        case 'reminders:send':
        case 'recurrence:materialize':
        case 'snapshots:capture':
        case 'history:prune':
        case 'sessions:prune':
        case 'rate-limits:prune':
        case 'files:prune':
            [$summary, $succeeded] = ($jobs[$command]['run'])();
            fwrite($succeeded ? STDOUT : STDERR, $summary."\n");
            if (!$succeeded) {
                exit(1);
            }
            break;

        case 'schedule:run':
            foreach ($scheduler()->runDue() as $name => $status) {
                fwrite(STDOUT, sprintf("%-24s %s\n", $name, $status));
            }
            break;

        case 'schedule:work':
            // Long-running alternative to cron: checks the schedule every minute.
            fwrite(STDOUT, "Scheduler running. Press Ctrl+C to stop.\n");
            $worker = $scheduler();
            while (true) {
                $started = time();
                foreach ($worker->runDue() as $name => $status) {
                    fwrite(STDOUT, sprintf("[%s] %-24s %s\n", gmdate('Y-m-d H:i:s'), $name, $status));
                }
                sleep(max(1, 60 - (time() - $started)));
            }

        case 'migrate':
            $completed = $application['migrations']->migrate();
            fwrite(STDOUT, $completed === [] ? "No pending migrations.\n" : 'Applied: '.implode(', ', $completed)."\n");
            break;

        case 'migrate:status':
            foreach ($application['migrations']->status() as $migration) {
                fwrite(STDOUT, sprintf("%-20s %s\n", $migration['status'], $migration['name']));
            }
            break;

        case 'migrate:check':
            $application['migrations']->check();
            fwrite(STDOUT, "Migration state is healthy.\n");
            break;

        case 'routes':
            foreach ($runtime()['router']->routes() as $route) {
                fwrite(STDOUT, sprintf(
                    "%-12s %-48s %s\n",
                    implode('|', $route->methods),
                    $route->path,
                    $route->name,
                ));
            }
            break;

        case 'areas:backfill':
            $service = new PlanningService(
                new PdoPlanningRepository($application['pdo']),
                $application['transactions'],
                new GraphGuard,
                new GoalProgressCalculator,
                $application['uuid'],
                $application['clock'],
                new PdoActivityRepository($application['pdo']),
                new PdoTaskSeriesRepository($application['pdo']),
            );
            fwrite(STDOUT, 'Created Areas: '.$service->backfillDefaultAreas()."\n");
            break;

        case 'users:role':
            $email = strtolower(trim((string) ($argv[2] ?? '')));
            $role = $argv[3] ?? '';
            if ($email === '' || !in_array($role, ['user', 'admin'], true)) {
                fwrite(STDERR, "Usage: php bin/console users:role <email> admin|user\n");
                exit(2);
            }
            $accounts = new PdoAccountRepository($application['pdo']);
            $user = $accounts->findByEmail($email);
            if ($user === null) {
                fwrite(STDERR, "No account uses that email.\n");
                exit(1);
            }
            $accounts->setRole($user->id, $role, $application['clock']->now()->format('Y-m-d H:i:s.u'));
            fwrite(STDOUT, sprintf("%s is now %s.\n", $email, $role));
            break;

        case 'mail:test':
            $recipient = trim((string) ($argv[2] ?? ''));
            if (filter_var($recipient, FILTER_VALIDATE_EMAIL) === false) {
                fwrite(STDERR, "Usage: php bin/console mail:test <email>\n");
                exit(2);
            }
            $runtime()['mailer']->sendMessage($recipient, 'Planner test email', "This message confirms that Planner can send email.\n");
            fwrite(STDOUT, $runtime()['mailer']->delivers()
                ? "Test email sent to $recipient.\n"
                : "No SMTP server is configured; the message was saved to the local mail outbox.\n");
            break;

        case 'help':
            fwrite(STDOUT, "Available commands:\n  schedule:run    run periodic jobs that are due (call from cron every minute)\n  schedule:work   keep running periodic jobs every minute\n  mail:test <email>\n  users:role <email> admin|user\n  ".implode("\n  ", array_keys($jobs))."\n  migrate\n  migrate:status\n  migrate:check\n  routes\n  areas:backfill\n");
            break;

        default:
            fwrite(STDERR, "Unknown command [$command].\n");
            exit(2);
    }
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");
    exit(1);
} finally {
    if ($http !== null) {
        $http['session']->close();
    }
}
