  "cards": [
    {
      "dot": "cyan",
      "title": "Different axes",
      "items": [
        "Time views overlap; they are not stored Task types. Inbox is an optional primary location.",
        "Badges apply the same view/status/search pipeline; Repeating counts non-Ended series."
      ]
    },
    {
      "dot": "amber",
      "title": "History boundary",
      "items": [
        "Current Task views exclude history-qualified Tasks. Recently Done work has a separate section.",
        "Retention/cap maintenance can archive history and is distinct from this browser projection."
      ]
    }
