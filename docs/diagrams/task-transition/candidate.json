  "cards": [
    {
      "dot": "amber",
      "title": "Conditional branch",
      "items": [
        "The 422/confirmation round-trip occurs only when the domain requires it; otherwise proceed directly to the write.",
        "A declined acknowledgement performs no change. Version conflicts require reconciliation, not blind retry."
      ]
    },
    {
      "dot": "emerald",
      "title": "Atomic side effects",
      "items": [
        "Task status, due-date changes, completed timestamp, Activity and confirmed ancestor reopens share one transaction; replanning unfinished work emits no completion reversal.",
        "Milestone prerequisite locks do not prevent completing Tasks inside that Milestone."
      ]
    }
  ]
