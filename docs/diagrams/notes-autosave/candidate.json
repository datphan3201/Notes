      "dot": "emerald",
      "title": "Transition conditions",
      "items": [
        "Dirty → Saving: 500ms inactivity, max 2s; no dispatch during IME composition.",
        "Saving → Saved: Only the current acknowledged draft is Saved.",
        "Saving → Retry wait: Network / 429 / 5xx within the retry limit.",
        "Retry wait → Saving: Resume when online; preserve request identity.",
        "Conflict → Dirty: Adopt the current base, retain local intent; save remains explicit.",
        "Auth expired → Conflict: After verifying the authenticated account; compare frozen/current versions."
      ]
    },
